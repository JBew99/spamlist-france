rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authentication helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Replace with your admin emails
      return request.auth.token.email in ['admin@spamlist.fr', 'mod@spamlist.fr'];
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    // Public read for lists/levels (no auth required)
    match /levels/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      // Users can create their own profile (via auth trigger)
      allow create: if isSignedIn() && isOwner(userId);
      
      // Only admins can modify user data
      allow update: if isAdmin();
      
      // Admins only delete
      allow delete: if isAdmin();
    }
    
    // Records collection (user submissions)
    match /records/{recordId} {
      // Users can read all (for leaderboard)
      allow read: if isSignedIn();
      
      // Users can create their own records
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can approve/reject
      allow update: if isAdmin() && request.resource.data.userId == resource.data.userId;
      
      // Only admins delete
      allow delete: if isAdmin();
    }
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
