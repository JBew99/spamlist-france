rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========== HELPER FUNCTIONS ==========
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.email in ['jblash99@gmail.com'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isApproved(doc) {
      return doc.status == 'approved';
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ========== LEVELS COLLECTION ==========
    match /levels/{levelId} {
      // Anyone can read approved levels
      allow read: if isApproved(resource.data) || isAdmin();
      
      // Signed-in users can create levels (must be pending)
      allow create: if isSignedIn() && 
        request.resource.data.status == 'pending' &&
        hasRequiredFields(['levelId', 'name', 'creator', 'difficulty']);
      
      // Only admins can update levels
      allow update: if isAdmin();
      
      // Only admins can delete levels
      allow delete: if isAdmin();
    }

    match /levels/{document=**} {
      allow read: if isApproved(get(/databases/$(database)/documents/levels/$(document)).data) || isAdmin();
    }

    // ========== USERS COLLECTION ==========
    match /users/{userId} {
      // Anyone can read user profiles (for leaderboard)
      allow read: if true;
      
      // Users can only create their own profile
      allow create: if isOwner(userId) && 
        isSignedIn() &&
        hasRequiredFields(['name', 'email']);
      
      // Only admins can update user data
      allow update: if isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ========== RECORDS COLLECTION ==========
    match /records/{recordId} {
      // Anyone can read records (for activity feed, leaderboard)
      allow read: if true;
      
      // Signed-in users can create records for themselves only
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        hasRequiredFields(['userId', 'levelName', 'playerName', 'videoUrl', 'status']);
      
      // Only admins can update records (to approve/reject)
      allow update: if isAdmin();
      
      // Only admins can delete records
      allow delete: if isAdmin();
    }

    // ========== SUBMISSIONS COLLECTION (for level submissions) ==========
    match /submissions/{submissionId} {
      // Only admins can read submissions
      allow read: if isAdmin();
      
      // Signed-in users can create submissions
      allow create: if isSignedIn() &&
        hasRequiredFields(['userId', 'levelId', 'levelName', 'creator', 'difficulty']);
      
      // Only admins can update submissions
      allow update: if isAdmin();
      
      // Only admins can delete submissions
      allow delete: if isAdmin();
    }

    // ========== DEFAULT DENY ==========
    // Deny all other reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
