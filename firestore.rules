rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authentication helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Replace with your admin emails
      return request.auth.token.email in ['jblash99@gmail.com', 'admin@spamlist.fr', 'mod@spamlist.fr'];
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    // Public read for lists/levels (no auth required)
    match /levels/{document=**} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      // Public leaderboard and profile reads
      allow read: if true;
      
      // Users can create their own profile
      allow create: if isSignedIn() && isOwner(userId);
      
      // Only admins can modify or delete user data
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Records collection (user submissions)
    match /records/{recordId} {
      // Public read for approved records, while owners and admins can also read private records
      allow read: if resource.data.status == 'approved' || isOwner(resource.data.userId) || isAdmin();
      
      // Users can create their own records and they must be pending
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      
      // Only admins can approve/reject or delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
